                  <BeforePrintEvent>ForCheckFinancialVAT = CheckFinancialVAT(ForCheckFinancialVAT, ForApplyVATToFinancialCosts, Good_receipts.TValue, Good_receipts.FinancialC, Good_receipt_lines.TaxValue);
