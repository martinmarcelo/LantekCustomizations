          <AfterPrintEvent>ForDNotesList="";
ForOrdersList="";
ForTaxesBreakdown = IIF(ForTaxesBreakdown != "", ForTaxesBreakdown,IIF(Invoices.TValue!=Invoice_lines.TaxValue,"1","")).ToString();
if(ForPreviousTax == -5)
{
