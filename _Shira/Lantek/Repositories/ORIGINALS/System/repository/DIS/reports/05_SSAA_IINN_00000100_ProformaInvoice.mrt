                <GroupHeaderBand1 Ref="87" type="GroupHeaderBand" isKey="true">
                  <AfterPrintEvent>ForCheckFinancialVAT = CheckFinancialVAT(ForCheckFinancialVAT, ForApplyVATToFinancialCosts, Invoices.TValue, Invoices.FinancialC, Invoice_lines.TaxValue);
ForCheckCarrierVAT = CheckCarrierVAT(ForCheckCarrierVAT, Invoices.TValue, Invoices.CarrierC, Invoice_lines.TaxValue);
if( ForNumberLineTaxes &lt; 2 &amp;&amp; Invoices.CarrierC == 0)
{	//If the CarrierC =0 and the Lines all have the same tax and it's different to the Purchase/Quote/Sale/Invoice, etc
	// that FooterBand will be hidden and only one tax will be displayed, but as we have set ForTaxesBreakdown
	// to "1" the amount in brackets will be shown because we think there is more than one line. 
	// Here we fix that. ForNumberLineTaxes contains the number of taxes in the lines.
	if(ForApplyVATToFinancialCosts==false)
	{
		ForTaxesBreakdown = "";
	}
	//if set to 
	else if(ForApplyVATToFinancialCosts==true &amp;&amp; Invoices.FinancialC == 0)
	{
		ForTaxesBreakdown = "";
	}	
}</AfterPrintEvent>
