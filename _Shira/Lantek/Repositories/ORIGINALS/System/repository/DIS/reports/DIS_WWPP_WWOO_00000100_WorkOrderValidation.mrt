  <Script>using System;
using System.Drawing;
using System.Windows.Forms;
using System.Data;
using Stimulsoft.Controls;
using Stimulsoft.Base.Drawing;
using Stimulsoft.Report;
using Stimulsoft.Report.Dialogs;
using Stimulsoft.Report.Components;

namespace Reports
{
    public class DIS_WWPP_WWOO_00000100_WorkOrderValidation : Stimulsoft.Report.StiReport
    {
        public DIS_WWPP_WWOO_00000100_WorkOrderValidation()        {
            this.InitializeComponent();
        }
		
		public string CalculateTime(double time, int quantity) {
			double totalSeconds = quantity &gt; 0 ? time * quantity : time;
			TimeSpan t = new TimeSpan(0, 0, (int)Math.Round(totalSeconds,0));
			string minutes = "00";
			string seconds = "00";
			string totalHours = "00";
			if (t.Minutes != 0) minutes = t.Minutes.ToString();
			if (t.Seconds != 0) seconds = t.Seconds.ToString();
			if (t.TotalHours != 0) totalHours = ((int)t.TotalHours).ToString();
			return string.Format("{0}:{1}:{2}", totalHours, minutes, seconds);
		}

        #region StiReport Designer generated code - do not modify
		#endregion StiReport Designer generated code - do not modify
    }
}</Script>
