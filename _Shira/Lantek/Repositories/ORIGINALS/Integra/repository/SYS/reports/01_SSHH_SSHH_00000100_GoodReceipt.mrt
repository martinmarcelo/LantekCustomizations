  <Script>using System;
using System.Drawing;
using System.Windows.Forms;
using System.Data;
using Stimulsoft.Controls;
using Stimulsoft.Base.Drawing;
using Stimulsoft.Report;
using Stimulsoft.Report.Dialogs;
using Stimulsoft.Report.Components;

namespace Reports
{
    public class SSHH_SSHH_00000100_GoodReceipt : Stimulsoft.Report.StiReport
    {
        public SSHH_SSHH_00000100_GoodReceipt()        {
            this.InitializeComponent();
        }
		
		public string FormatQuantity(double quantity, string quantityCategory, string weightUnit) {
			if (quantityCategory.Equals("WGH"))
				return quantity &gt;= 1000.0 ? String.Format("{0:0,0.000}", quantity) + " " + weightUnit : String.Format("{0:0.000}", quantity) + " " + weightUnit;
			else
				return String.Format("{0:0,0}", quantity);
		}

        #region StiReport Designer generated code - do not modify
		#endregion StiReport Designer generated code - do not modify
    }
}</Script>
