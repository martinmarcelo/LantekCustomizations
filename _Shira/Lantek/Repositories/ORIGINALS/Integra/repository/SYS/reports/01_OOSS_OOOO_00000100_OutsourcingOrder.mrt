            <Panel2 Ref="92" type="Stimulsoft.Report.Components.StiPanel" isKey="true">
              <Brush>Transparent</Brush>
              <CanShrink>True</CanShrink>
              <ClientRectangle>10.6,2.4,8.2,7.2</ClientRectangle>
              <Components isList="true" count="5">
                <GroupHeaderBand1 Ref="93" type="GroupHeaderBand" isKey="true">
                  <BeforePrintEvent>
                                        ForCheckFinancialVAT = CheckFinancialVAT(ForCheckFinancialVAT, ForApplyVATToFinancialCosts, Outsourcing_orders.TValue, Outsourcing_orders.FinancialC, Outsourcing_order_lines.TaxValue);
                                        ForCheckCarrierVAT = CheckCarrierVAT(ForCheckCarrierVAT, Outsourcing_orders.TValue, Outsourcing_orders.CarrierC, Outsourcing_order_lines.TaxValue);
                                        if( ForNumberLineTaxes &lt; 2 &amp;&amp; Outsourcing_orders.CarrierC == 0)
                                        {	//If the CarrierC =0 and the Lines all have the same tax and it's different to the Purchase/Quote/Sale/Invoice, etc
                                        // that FooterBand will be hidden and only one tax will be displayed, but as we have set ForTaxesBreakdown
                                        // to "1" the amount in brackets will be shown because we think there is more than one line.
                                        // Here we fix that. ForNumberLineTaxes contains the number of taxes in the lines.
                                        if(ForApplyVATToFinancialCosts==false)
                                        {
                                        ForTaxesBreakdown = "";
                                        }
                                        //if set to
                                        else if(ForApplyVATToFinancialCosts==true &amp;&amp; Outsourcing_orders.FinancialC == 0)
                                        {
                                        ForTaxesBreakdown = "";
                                        }
                                        }
                                    </BeforePrintEvent>
                  <Brush>Transparent</Brush>
                  <ClientRectangle>0,0.4,8.2,0.6</ClientRectangle>
                  <Components isList="true" count="2">
                    <Text39 Ref="94" type="Text" isKey="true">
                      <Brush>Transparent</Brush>
                      <ClientRectangle>1,0.2,4,0.4</ClientRectangle>
