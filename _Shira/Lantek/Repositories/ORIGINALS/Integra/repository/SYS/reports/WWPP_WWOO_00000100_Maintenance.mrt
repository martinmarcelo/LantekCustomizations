  <Script>using System;
using System.Drawing;
using System.Windows.Forms;
using System.Data;
using Stimulsoft.Controls;
using Stimulsoft.Base.Drawing;
using Stimulsoft.Report;
using Stimulsoft.Report.Dialogs;
using Stimulsoft.Report.Components;

namespace Reports
{
    public class w : Stimulsoft.Report.StiReport
    {
        public w()        {
            this.InitializeComponent();
        }

		public string GetTimeFormatFromSeconds(double seconds) {
			int roundedSeconds = (int)Math.Round(seconds, 0, MidpointRounding.AwayFromZero);
			int numHours = (roundedSeconds / 3600);
            int numMinutes = ((roundedSeconds - numHours * 3600) / 60);
            int numSeconds = roundedSeconds - (numHours * 3600 + numMinutes * 60);
			TimeSpan timeSpan = new TimeSpan(numHours, numMinutes, numSeconds);
			return string.Format("{0}:{1}:{2}", ((int)timeSpan.TotalHours).ToString("D2"), timeSpan.Minutes.ToString("D2"), timeSpan.Seconds.ToString("D2"));
		}
		
		public string GetShortDateTime(DateTime dt) {
			return string.Format("{0:d}", dt);
		}
		
		public string GetTimeFormatFromHours(double hours) {
			int roundedSeconds = (int)Math.Round((hours * 3600), 0, MidpointRounding.AwayFromZero);
			int numHours = (roundedSeconds / 3600);
            int numMinutes = ((roundedSeconds - numHours * 3600) / 60);
            int numSeconds = roundedSeconds - (numHours * 3600 + numMinutes * 60);
			TimeSpan timeSpan = new TimeSpan(numHours, numMinutes, numSeconds);
			return string.Format("{0}:{1}:{2}", ((int)timeSpan.TotalHours).ToString("D2"), timeSpan.Minutes.ToString("D2"), timeSpan.Seconds.ToString("D2"));
		}
		
		public string GetUnitFormat(string unit){
			string returnValue = unit;
			if (unit.Equals("oC")){
				returnValue = "ºC";
			}
			else if (unit.Equals("oF")){
				returnValue = "ºF";
			}
			else if (unit.Equals("o")){
				returnValue = "º";
			}
			returnValue = returnValue.Replace("1","¹");
			returnValue = returnValue.Replace("2","²");
			returnValue = returnValue.Replace("3","³");
			return returnValue;
		}
		
        #region StiReport Designer generated code - do not modify
		#endregion StiReport Designer generated code - do not modify
    }
}</Script>
