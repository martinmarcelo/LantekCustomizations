                <GroupHeaderBand1 Ref="76" type="GroupHeaderBand" isKey="true">
                  <BeforePrintEvent>ForCheckFinancialVAT = CheckFinancialVAT(ForCheckFinancialVAT, ForApplyVATToFinancialCosts, Purchase_order.TValue, Purchase_order.FinancialC, Purchase_order_lines.TaxValue);
ForCheckCarrierVAT = CheckCarrierVAT(ForCheckCarrierVAT, Purchase_order.TValue, Purchase_order.CarrierC, Purchase_order_lines.TaxValue);
if( ForNumberLineTaxes &lt; 2 &amp;&amp; Purchase_order.CarrierC == 0)
{	//If the CarrierC =0 and the Lines all have the same tax and it's different to the Purchase/Quote/Sale/Invoice, etc
	// that FooterBand will be hidden and only one tax will be displayed, but as we have set ForTaxesBreakdown
	// to "1" the amount in brackets will be shown. Here we fix that.
	if(ForApplyVATToFinancialCosts==false)
	{
		ForTaxesBreakdown = "";
	}
	//if set to 
	else if(ForApplyVATToFinancialCosts==true &amp;&amp; Purchase_order.FinancialC == 0)
	{
		ForTaxesBreakdown = "";
	}	
}</BeforePrintEvent>
