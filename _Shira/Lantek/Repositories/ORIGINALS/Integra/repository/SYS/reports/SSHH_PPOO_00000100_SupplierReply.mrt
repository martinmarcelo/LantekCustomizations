        <PurchaseOrderLines Ref="54" type="DataBand" isKey="true">
          <AfterPrintEvent>ForTaxesBreakdown = IIF(ForTaxesBreakdown != "", ForTaxesBreakdown,
IIF(Purchase_order.TValue!=Purchase_order_lines.TaxValue,"1","")).ToString();
if(ForPreviousTax == -5)
{
	ForNumberLineTaxes++;
	ForPreviousTax = Purchase_order_lines.TaxValue;
}
else if (ForPreviousTax != Purchase_order_lines.TaxValue)
{
	ForNumberLineTaxes++;
	//stop here, recognizing two different tax values in the lines is enough for our purpose
}</AfterPrintEvent>
