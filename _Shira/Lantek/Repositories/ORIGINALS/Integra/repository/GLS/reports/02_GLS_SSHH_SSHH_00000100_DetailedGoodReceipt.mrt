  <ReportGuid>fcb083504c6c4a12ad6ae0afd79c4aab</ReportGuid>
  <ReportName>02_GLS_SSHH_SSHH_00000100_DetailedGoodReceipt</ReportName>
  <ReportUnit>Centimeters</ReportUnit>
  <ReportVersion>2013.2.1604</ReportVersion>
  <Script>using System;
using System.Collections.Generic;
using System.Drawing;
using System.Windows.Forms;
using System.Data;
using Stimulsoft.Controls;
using Stimulsoft.Base.Drawing;
using Stimulsoft.Report;
using Stimulsoft.Report.Dialogs;
using Stimulsoft.Report.Components;

namespace Reports
{
    public class SSHH_SSHH_00000100_GoodReceipt : Stimulsoft.Report.StiReport
    {
        public SSHH_SSHH_00000100_GoodReceipt()        {
            this.InitializeComponent();
        }
		
		public class BatchAndQuantity
		{
			public string batch;
			public double quantity;
			
			public BatchAndQuantity(string batchNo, double quantityNo)
			{
				batch = batchNo;
				quantity = quantityNo;
			}
		}
		
		List&lt;BatchAndQuantity&gt; lista;
		List&lt;BatchAndQuantity&gt; myLineList;
		
		Dictionary&lt;int, List&lt;BatchAndQuantity&gt;&gt; batch;
		
		public void AddNewToExisting(int lineNum, double quantity, string batchNo)
		{
			BatchAndQuantity temporal = new BatchAndQuantity(batchNo, quantity);
			myLineList.Add(temporal);
			batch[lineNum] = myLineList;
		}
		
		public void AddNewToEmpty(int lineNum, double quantity, string batchNo)
		{
			BatchAndQuantity temporal = new BatchAndQuantity(batchNo, quantity);
			myLineList = new List&lt;BatchAndQuantity&gt;();
			myLineList.Add(temporal);
			batch.Add(lineNum, myLineList);
		}
		
		public string GetQuantity (int lineNum, double lineQuantity)
		{
			string result="";
			double total=0;
			int lines=0;
			
			if (batch.TryGetValue(lineNum, out lista))
			{
				foreach (BatchAndQuantity element in lista)
				{
					result += element.quantity + "\n";
					total += element.quantity;
					lines++;
				}
				if(total &lt; lineQuantity)
				{
					result += (lineQuantity - total) + "\n";
				}
				return result;
			}
			else
			{
				return lineQuantity.ToString();
			}
		}
		
		public string GetBatch (int lineNum, double lineQuantity)
		{
			string result="";
			double total=0;
			int lines = 0;
			
			foreach (BatchAndQuantity element in batch[lineNum])
			{
				result += element.batch + "\n";
				total += element.quantity;
				lines++;
			}
			if(total &lt; lineQuantity)
			{
				result += "" + "\n";
			}
			
			return result;
		}
		
		public string FormatQuantity(double quantity, string quantityCategory, string weightUnit) {
			if (quantityCategory.Equals("WGH"))
				return quantity &gt;= 1000.0 ? String.Format("{0:0,0.000}", quantity) + " " + weightUnit : String.Format("{0:0.000}", quantity) + " " + weightUnit;
			else
				return String.Format("{0:0,0}", quantity);
		}

        #region StiReport Designer generated code - do not modify
		#endregion StiReport Designer generated code - do not modify
    }
}</Script>
