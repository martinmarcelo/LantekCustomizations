          <BeforePrintEvent>DateTime date=Today;
DateTime date2=WORKCENTER_SCHEDULING_REPORT.SDate;
int x = (int)DateDiff(date, date2).TotalMinutes;
tester = x.ToString();
if (WORKCENTER_SCHEDULING_REPORT.ReportType==0){
	if (x==0){
		boldTittle = true;
	}else{
		boldTittle = false;
	}
}else{
	if((0&lt;=x)&amp;&amp;(x&lt;11340)){
		boldTittle = true;
	}else{
		boldTittle = false;
	}
}</BeforePrintEvent>
