using Stimulsoft.Report.Components;

namespace Reports
{
    public class DIS_MMNN_MMOO_00000100_RouteSheet : Stimulsoft.Report.StiReport
    {
        public DIS_MMNN_MMOO_00000100_RouteSheet()        {
            this.InitializeComponent();
        }
		
		public string CalculateTime(double time, int quantity) {
			double totalSeconds = quantity &gt; 0 ? time * quantity : time;
			return new TimeSpan(0, 0, (int)totalSeconds).ToString();
		}
		
		public bool CheckBendingOperation(short technology, bool hasBendingOperation) {
			if (technology == 20) return true;
			else return hasBendingOperation;
		}

        #region StiReport Designer generated code - do not modify
		#endregion StiReport Designer generated code - do not modify
    }
}
</Script>
