            <Panel4 Ref="99" type="Stimulsoft.Report.Components.StiPanel" isKey="true">
              <Brush>Transparent</Brush>
              <CanShrink>True</CanShrink>
              <ClientRectangle>11.2,2.2,7.4,6.8</ClientRectangle>
              <Components isList="true" count="5">
                <GroupHeaderBand3 Ref="100" type="GroupHeaderBand" isKey="true">
                  <BeforePrintEvent>ForCheckFinancialVAT = CheckFinancialVAT(ForCheckFinancialVAT, ForApplyVATToFinancialCosts, Sale_order.TValue, Sale_order.FinancialC, Sale_order_lines.TaxValue);
ForCheckCarrierVAT = CheckCarrierVAT(ForCheckCarrierVAT, Sale_order.TValue, Sale_order.CarrierC, Sale_order_lines.TaxValue);
	if( ForNumberLineTaxes &lt; 2 &amp;&amp; Sale_order.CarrierC == 0)
{	//If the CarrierC =0 and the Lines all have the same tax and it's different to the Purchase/Quote/Sale/Invoice, etc
	// that FooterBand will be hidden and only one tax will be displayed, but as we have set ForTaxesBreakdown
	// to "1" the amount in brackets will be shown because we think there is more than one line. 
	// Here we fix that. ForNumberLineTaxes contains the number of taxes in the lines.
	if(ForApplyVATToFinancialCosts==false)
	{
		ForTaxesBreakdown = "";
	}
		//if set to 
	else if(ForApplyVATToFinancialCosts==true &amp;&amp; Sale_order.FinancialC == 0)
	{
		ForTaxesBreakdown = "";
	}	
}</BeforePrintEvent>
                  <Brush>Transparent</Brush>
                  <CanShrink>True</CanShrink>
                  <ClientRectangle>0,0.4,7.4,0.6</ClientRectangle>
                  <Components isList="true" count="2">
                    <Text93 Ref="101" type="Text" isKey="true">
                      <Brush>Transparent</Brush>
                      <ClientRectangle>0.4,0.2,4,0.4</ClientRectangle>
                      <Conditions isList="true" count="0" />
                      <Font>Calibri Light,10,Bold</Font>
                      <Guid>20517dafe18d417a8e8b46c898ee3507</Guid>
                      <Margins>0,0,0,0</Margins>
                      <Name>Text93</Name>
                      <Page isRef="6" />
                      <Parent isRef="100" />
                      <Text>{Sale_order.TaxRef__Lab} {Sale_order_lines.TaxValue__Scr} {IIF(ForTaxesBreakdown=="","",("(" + Sale_order.TotalA__Prf + Format("{0:N"+ Sale_order.Currency_FisDecs + "}", Abs(AddCarrierAndFinancialVATAmount(SumD(DataBand4, Sale_order_lines.TPrice), Sale_order.CarrierC, Sale_order.FinancialC, Sale_order_lines.TaxValue, Sale_order.TValue, ForApplyVATToFinancialCosts)))) + Sale_order.TotalA__Sff + ")").ToString()}</Text>
                      <TextBrush>Black</TextBrush>
                      <Type>Expression</Type>
                      <VertAlignment>Center</VertAlignment>
                    </Text93>
                    <Text94 Ref="102" type="Text" isKey="true">
                      <Brush>Transparent</Brush>
                      <ClientRectangle>4.6,0.2,2.8,0.4</ClientRectangle>
                      <Conditions isList="true" count="0" />
                      <Font>Calibri Light,10</Font>
                      <Guid>f2506a3c753940fd8ba368e9f46c9ca1</Guid>
                      <HorAlignment>Right</HorAlignment>
                      <Margins>0,0,0,0</Margins>
                      <Name>Text94</Name>
                      <Page isRef="6" />
                      <Parent isRef="100" />
                      <Text>{Sale_order.TotalA__Prf}{Format("{0:N"+ Sale_order.Currency_FisDecs + "}", AddCarrierAndFinancialVATAmount(SumD(DataBand4, Sale_order_lines.TPrice), Sale_order.CarrierC, Sale_order.FinancialC, Sale_order_lines.TaxValue, Sale_order.TValue, ForApplyVATToFinancialCosts) * (Sale_order_lines.TaxValue / 100))}{Sale_order.TotalA__Sff}</Text>
                      <TextBrush>Black</TextBrush>
                      <Type>Expression</Type>
                      <VertAlignment>Center</VertAlignment>
                    </Text94>
                  </Components>
